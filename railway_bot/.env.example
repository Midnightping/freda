# ========================================================
# DataMart 24/7 WhatsApp Auto-Redeemer (Railway Config)
# ========================================================

# 1. Target Phone Number to receive the free data (e.g. 0244123456)
TARGET_PHONE=0244123456

# 2. DataMart Session Auth Tokens (for Multi-Token round-robin speed)
#    Get from Chrome DevTools on beta.datamartgh.shop -> localStorage.getItem('authToken')
#    Separate multiple tokens with commas: token1,token2,token3
DATAMART_TOKENS=your_datamart_token_here

# 3. Dedicated Bot WhatsApp Number (including country code, e.g. 233501234567)
#    When set, the bot prints an 8-character pairing code in Railway logs for easy linking!
BOT_PHONE_NUMBER=233501234567

# 4. Your Personal WhatsApp Number to receive winning DM alerts (e.g. 233241234567)
OWNER_PHONE=233241234567

# 5. WhatsApp Channel JID (Optional - leave blank to listen to any followed channel)
#    Example: 120363xxxxxxxxx@newsletter
CHANNEL_JID=

# 6. Scanning Strategy: 'reverse' (Bottom-up, recommended), 'shuffle', 'middle', 'top'
SCAN_ORDER=reverse

# 7. Persistent storage paths (Railway Volume mount path is typically /data)
DATA_DIR=/data
SESSION_DIR=/data/session
